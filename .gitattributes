# GitHub Linguist language detection overrides
#
# This repo is a Kotlin app, but it carries a lot of Markdown (README, AGENTS, DESIGN,
# and the .agents/ skill files) - enough to skew the language bar if it is counted.

*.md linguist-detectable=false
*.mdx linguist-detectable=false
*.markdown linguist-detectable=false

# Explicitly mark real source as detectable (defensive)
*.kt linguist-detectable=true

# Force LF line endings for shell scripts across all sub-projects,
# regardless of each contributor's local core.autocrlf setting.
*.sh text eol=lf
gradlew text eol=lf
gradle-wrapper.properties text eol=lf

# The Makefile must be LF too. Its recipes are POSIX shell, and on Windows they run under
# Git Bash - where a trailing CR from a CRLF checkout becomes part of the command and
# breaks every recipe. core.autocrlf=true (the Git for Windows default) would do exactly
# that without this line.
Makefile text eol=lf
